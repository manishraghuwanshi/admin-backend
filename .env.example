# =============================================================================
# Admin backend — environment template
#
# Copy to `.env` and fill in real values. Never commit `.env`, never paste real
# credentials into tickets or logs, and never read secrets from this file —
# it only documents which variables the application validates at startup.
# Note: dotenv does NOT override variables already present in process.env, so
# the environment (or the test harness) always wins over `.env`.
# =============================================================================

# --- Runtime ---------------------------------------------------------------

# development | test | production (default: development)
NODE_ENV=development

# Port the HTTP server listens on (default: 5000)
PORT=5000

# debug | info | warn | error (default: debug, info when NODE_ENV=production)
# LOG_LEVEL=debug

# Grace period for graceful shutdown, in milliseconds (default: 10000)
# SHUTDOWN_TIMEOUT_MS=10000

# --- Database (Neon PostgreSQL) --------------------------------------------

# Pooled connection string. REQUIRED in every environment, including test: the
# PGlite test harness supplies a throwaway value and swaps the driver itself via
# `setDbOverride()`, so no test ever connects to this URL.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Direct (unpooled) connection string. Optional; used for migrations/admin work.
DATABASE_URL_UNPOOLED=

# Neon branch this environment targets. Optional; recorded in readiness output
# so it is obvious which branch a deployment points at.
NEON_BRANCH=

# --- CORS and networking ---------------------------------------------------

# Comma-separated absolute origins allowed to call the API with credentials.
# REQUIRED in production. Development/test also accept any localhost/127.0.0.1
# origin. This list doubles as the CSRF origin allow-list.
CORS_ORIGINS=http://localhost:5173

# Express "trust proxy": true, false, or a hop count (default: false).
# Enable only when running behind a reverse proxy you control, otherwise
# clients can spoof X-Forwarded-For and bypass IP-based rate limiting.
TRUST_PROXY=false

# Maximum JSON request body size, e.g. 100kb or 1mb (default: 100kb)
# Image uploads are a JSON body carrying base64 data, so this caps them before
# MAX_UPLOAD_BYTES does: a 100kb body holds roughly 75kb of image. Raise BOTH to
# accept larger images through POST /api/products/:productId/images.
# JSON_BODY_LIMIT=100kb

# --- Authentication / JWT --------------------------------------------------

# REQUIRED signing secrets, minimum 32 characters each. Generate per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=

# Access-token lifetime in seconds (default: 900, allowed: 60-3600)
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh-session lifetime in seconds (default: 604800 = 7 days, 1h-30d)
# AUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# SameSite for auth cookies: lax | strict | none
# (default: "none" in production, "lax" otherwise; "none" forces Secure)
# AUTH_COOKIE_SAMESITE=lax

# Auth cookie names (defaults shown)
# AUTH_COOKIE_NAME_ACCESS=admin_access_token
# AUTH_COOKIE_NAME_REFRESH=admin_refresh_token

# Days a revoked/expired refresh session is retained before cleanup removes it
# (default: 30, allowed: 1-365)
# SESSION_RETENTION_DAYS=30

# --- Neon Object Storage (private `product-images` bucket) -----------------

AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Private bucket that holds product images (default: product-images)
# STORAGE_BUCKET=product-images

# Largest accepted image upload in bytes (default: 5242880 = 5 MiB, 1 KiB-20 MiB)
# Applies to the image after base64 decoding. Has no effect unless JSON_BODY_LIMIT is
# also raised — see README.md, "Upload size limits".
# MAX_UPLOAD_BYTES=5242880

# Signed download-URL lifetime in seconds (default: 900, allowed: 60-3600)
# SIGNED_URL_TTL_SECONDS=900

# --- Notes for the automated test harness ----------------------------------

# There is no "skip auth secrets" flag on purpose. `vitest` runs with
# NODE_ENV=test and injects its own throwaway DATABASE_URL plus generated
# AUTH_* secrets in `src/tests/setup.ts`, so tests need no `.env` at all and can
# never touch the real Neon database or Object Storage bucket.

# --- Optional configuration ---------------------------------------------------
# All values below have safe defaults; uncomment to override.

# development | test | production (default: development)
# NODE_ENV=development

# debug | info | warn | error (default: debug, info when NODE_ENV=production)
# LOG_LEVEL=debug

# Comma-separated allowed origins. In development and test, any localhost /
# 127.0.0.1 origin is allowed automatically. In production this is required.
# CORS_ORIGINS=http://localhost:5173,https://admin.example.com

# Express "trust proxy" setting. true, false, or a hop count (default: false).
# TRUST_PROXY=false

# Maximum JSON request body size, e.g. 100kb or 1mb (default: 100kb).
# JSON_BODY_LIMIT=100kb

# Grace period for graceful shutdown in milliseconds (default: 10000).
# SHUTDOWN_TIMEOUT_MS=10000